# ── STEP 1: GENERATE VIDEO SCRIPT ───────────────────────────────────────────
def generate_script(issue):
    """Generate a compelling 60-second video script from today's newsletter"""
    log("Generating video script...")

    prompt = (
        f"Write a 60-second faceless finance video script for TikTok/YouTube Shorts.\n"
        f"Topic: {issue['headline']}\n"
        f"Key insight 1: {issue['story1_body'][:200]}\n"
        f"Key insight 2: {issue['story2_body'][:150]}\n"
        f"Tip: {issue['quick_tip']}\n\n"
        "Rules:\n"
        "- Hook in first 3 seconds (shocking stat or question)\n"
        "- No filler words, every sentence must add value\n"
        "- Conversational but authoritative tone\n"
        "- End with CTA to subscribe newsletter\n"
        "- 120-140 words total (60 seconds at normal speaking pace)\n"
        "- Do NOT say 'I' or reveal any personal details\n"
        "- Write as if an anonymous finance expert is speaking\n\n"
        "Return JSON:\n"
        "{\n"
        '  "hook": "first 1-2 sentences (the hook)",\n'
        '  "full_script": "complete 60-second script",\n'
        '  "text_overlays": ["5-7 short on-screen text lines, max 6 words each"],\n'
        '  "video_search_terms": ["3 Pexels search terms for background footage"]\n'
        "}"
    )

    client_req = requests.post(
        "https://api.anthropic.com/v1/messages",
        headers={"Content-Type": "application/json", "x-api-key": ANTHROPIC_API_KEY,
                 "anthropic-version": "2023-06-01"},
        json={"model": "claude-opus-4-5", "max_tokens": 800,
              "messages": [{"role": "user", "content": prompt}]}
    )
    raw = client_req.json()["content"][0]["text"].strip()
    raw = raw.replace("```json", "").replace("```", "").strip()
    return json.loads(raw)

# ── STEP 2: GENERATE AI VOICEOVER ───────────────────────────────────────────
def generate_voiceover(script_text, output_path):
    """Generate AI voiceover using ElevenLabs"""
    log("Generating AI voiceover with ElevenLabs...")

    if not ELEVENLABS_API_KEY:
        log("No ElevenLabs key, using silent audio")
        run(f'ffmpeg -f lavfi -i anullsrc=r=44100:cl=stereo -t 60 -q:a 9 -acodec libmp3lame "{output_path}" -y -loglevel quiet')
        return False

    r = requests.post(
        f"https://api.elevenlabs.io/v1/text-to-speech/{VOICE_ID}",
        headers={"Accept": "audio/mpeg", "Content-Type": "application/json",
                 "xi-api-key": ELEVENLABS_API_KEY},
        json={
            "text": script_text,
            "model_id": "eleven_monolingual_v1",
            "voice_settings": {
                "stability": 0.65,
                "similarity_boost": 0.85,
                "style": 0.3,
                "use_speaker_boost": True
            }
        },
        timeout=60
    )

    if r.status_code == 200:
        with open(output_path, "wb") as f:
            f.write(r.content)
        log(f"Voiceover generated: {output_path}")
        return True
    else:
        log(f"ElevenLabs error {r.status_code}: {r.text[:100]}")
        run(f'ffmpeg -f lavfi -i anullsrc=r=44100:cl=stereo -t 60 -q:a 9 -acodec libmp3lame "{output_path}" -y -loglevel quiet')
        return False

# ── STEP 3: DOWNLOAD STOCK FOOTAGE ──────────────────────────────────────────
def download_footage(search_terms, output_dir, count=3):
    """Download free stock videos from Pexels"""
    log(f"Downloading stock footage from Pexels...")
    Path(output_dir).mkdir(exist_ok=True)
    downloaded = []

    finance_fallbacks = [
        "money finance", "stock market", "business charts",
        "city skyline", "switzerland mountains", "banking"
    ]
    all_terms = list(search_terms) + finance_fallbacks

    for i, term in enumerate(all_terms):
        if len(downloaded) >= count:
            break
        try:
            r = requests.get(
                "https://api.pexels.com/videos/search",
                headers={"Authorization": PEXELS_API_KEY},
                params={"query": term, "per_page": 5, "orientation": "portrait",
                        "size": "medium"},
                timeout=15
            )
            if r.status_code != 200:
                continue

            videos = r.json().get("videos", [])
            for video in videos:
                files = video.get("video_files", [])
                # Get smallest HD portrait file
                portrait_files = [f for f in files if f.get("height", 0) >= 720
                                  and f.get("width", 0) < f.get("height", 0)]
                if not portrait_files:
                    portrait_files = [f for f in files if f.get("height", 0) >= 480]
                if not portrait_files:
                    continue

                video_file = min(portrait_files, key=lambda x: x.get("file_size", 999999999))
                dl = requests.get(video_file["link"], stream=True, timeout=30)
                if dl.status_code == 200:
                    path = f"{output_dir}/clip_{i}.mp4"
                    with open(path, "wb") as f:
                        for chunk in dl.iter_content(chunk_size=8192):
                            f.write(chunk)
                    downloaded.append(path)
                    log(f"Downloaded: {term} clip")
                    break
        except Exception as e:
            log(f"Footage download error for '{term}': {e}")
            continue

    if not downloaded:
        log("No footage downloaded, will use color background")
    return downloaded

# ── STEP 4: CREATE TEXT OVERLAY IMAGES ──────────────────────────────────────
def create_text_frames(text_overlays, headline, output_dir):
    """Create PNG frames with text overlays using Python PIL"""
    log("Creating text overlay frames...")
    from PIL import Image, ImageDraw, ImageFont
    import textwrap

    Path(output_dir).mkdir(exist_ok=True)
    frames = []

    # Brand colors
    BG_COLOR     = (10, 10, 20)       # near black
    GOLD         = (255, 215, 0)
    WHITE        = (255, 255, 255)
    DARK_OVERLAY = (0, 0, 0, 180)     # semi-transparent black

    W, H = 1080, 1920  # TikTok/Reels portrait format

    def make_frame(text, is_headline=False, frame_num=0):
        img = Image.new("RGB", (W, H), BG_COLOR)
        draw = ImageDraw.Draw(img)

        # Gold border lines
        draw.rectangle([0, 0, W, 8], fill=GOLD)
        draw.rectangle([0, H-8, W, H], fill=GOLD)
        draw.rectangle([0, 0, 8, H], fill=GOLD)
        draw.rectangle([W-8, 0, W, H], fill=GOLD)

        # Brand name top
        try:
            font_brand = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 42)
            font_main  = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 72 if is_headline else 64)
            font_small = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 38)
            font_cta   = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 46)
        except:
            font_brand = ImageFont.load_default()
            font_main  = font_brand
            font_small = font_brand
            font_cta   = font_brand

        # Brand bar
        draw.rectangle([0, 60, W, 140], fill=(20, 20, 40))
        brand_text = "THE SMART DOLLAR"
        bb = draw.textbbox((0, 0), brand_text, font=font_brand)
        bw = bb[2] - bb[0]
        draw.text(((W - bw) // 2, 85), brand_text, fill=GOLD, font=font_brand)

        # Main text in center
        wrapped = textwrap.fill(text, width=18 if is_headline else 22)
        lines = wrapped.split("\n")
        total_h = len(lines) * (font_main.size + 20)
        y_start = (H - total_h) // 2

        # Semi-transparent backing for text
        padding = 40
        draw.rectangle([80, y_start - padding, W - 80, y_start + total_h + padding],
                       fill=(0, 0, 0))

        for i, line in enumerate(lines):
            lb = draw.textbbox((0, 0), line, font=font_main)
            lw = lb[2] - lb[0]
            color = GOLD if is_headline and i == 0 else WHITE
            draw.text(((W - lw) // 2, y_start + i * (font_main.size + 20)),
                      line, fill=color, font=font_main)

        # Subscribe CTA at bottom
        draw.rectangle([0, H - 200, W, H - 8], fill=(20, 20, 40))
        cta = "FREE DAILY NEWSLETTER"
        cb = draw.textbbox((0, 0), cta, font=font_cta)
        cw = cb[2] - cb[0]
        draw.text(((W - cw) // 2, H - 175), cta, fill=GOLD, font=font_cta)
        url_text = SUBSCRIBE_URL.replace("https://", "")
        ub = draw.textbbox((0, 0), url_text, font=font_small)
        uw = ub[2] - ub[0]
        draw.text(((W - uw) // 2, H - 120), url_text, fill=WHITE, font=font_small)

        path = f"{output_dir}/frame_{frame_num:03d}.png"
        img.save(path)
        return path

    # Headline frame
    frames.append(make_frame(headline, is_headline=True, frame_num=0))

    # Content overlay frames
    for i, overlay in enumerate(text_overlays):
        frames.append(make_frame(overlay, is_headline=False, frame_num=i+1))

    log(f"Created {len(frames)} text frames")
    return frames

# ── STEP 5: COMPOSE FINAL VIDEO ─────────────────────────────────────────────
def compose_video(footage_paths, text_frames, audio_path, output_path, duration=60):
    """Compose final video using ffmpeg"""
    log("Composing final video with ffmpeg...")

    work_dir = "/tmp/video_work"
    Path(work_dir).mkdir(exist_ok=True)

    # Step A: Prepare background video (loop/concat footage to fill duration)
    bg_video = f"{work_dir}/background.mp4"

    if footage_paths:
        # Create concat list
        concat_file = f"{work_dir}/concat.txt"
        # Repeat footage list enough times to fill duration
        all_clips = []
        total_needed = duration + 10
        while sum([5 for _ in all_clips]) < total_needed:
            all_clips.extend(footage_paths)

        with open(concat_file, "w") as f:
            for clip in all_clips[:12]:  # max 12 clips
                f.write(f"file '{os.path.abspath(clip)}'\n")

        # Concat and trim to duration, scale to portrait 1080x1920
        run(f'ffmpeg -f concat -safe 0 -i "{concat_file}" '
            f'-vf "scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920" '
            f'-t {duration} -r 30 -c:v libx264 -preset fast -crf 28 '
            f'"{bg_video}" -y -loglevel error')
    else:
        # Animated gradient background (no footage needed)
        run(f'ffmpeg -f lavfi -i "color=c=0a0a14:size=1080x1920:rate=30" '
            f'-t {duration} -c:v libx264 -preset fast "{bg_video}" -y -loglevel error')

    # Step B: Create text overlay slideshow
    overlay_video = f"{work_dir}/overlays.mp4"
    if text_frames:
        frames_per_slide = max(3, duration // len(text_frames))
        frame_list = f"{work_dir}/frames.txt"
        with open(frame_list, "w") as f:
            for frame in text_frames:
                f.write(f"file '{os.path.abspath(frame)}'\n")
                f.write(f"duration {frames_per_slide}\n")
            # Last frame
            f.write(f"file '{os.path.abspath(text_frames[-1])}'\n")

        run(f'ffmpeg -f concat -safe 0 -i "{frame_list}" '
            f'-vf "scale=1080:1920" -r 30 -t {duration} '
            f'-c:v libx264 -preset fast -crf 26 '
            f'"{overlay_video}" -y -loglevel error')
    else:
        overlay_video = None

    # Step C: Blend background + text overlays
    blended = f"{work_dir}/blended.mp4"
    if overlay_video and os.path.exists(overlay_video):
        run(f'ffmpeg -i "{bg_video}" -i "{overlay_video}" '
            f'-filter_complex "[0:v]scale=1080:1920[bg];[1:v]scale=1080:1920,format=rgba,colorchannelmixer=aa=0.88[fg];[bg][fg]overlay=0:0[out]" '
            f'-map "[out]" -t {duration} -r 30 -c:v libx264 -preset fast -crf 24 '
            f'"{blended}" -y -loglevel error')
    else:
        blended = bg_video

    # Step D: Add audio
    if os.path.exists(audio_path):
        run(f'ffmpeg -i "{blended}" -i "{audio_path}" '
            f'-c:v copy -c:a aac -b:a 128k '
            f'-map 0:v:0 -map 1:a:0 '
            f'-shortest -t {duration} '
            f'"{output_path}" -y -loglevel error')
    else:
        run(f'ffmpeg -i "{blended}" -c copy "{output_path}" -y -loglevel error')

    if os.path.exists(output_path):
        size_mb = os.path.getsize(output_path) / (1024*1024)
        log(f"Video created: {output_path} ({size_mb:.1f}MB)")
        return True
    else:
        log("Video creation failed")
        return False

# ── STEP 6: SAVE TO GITHUB ──────────────────────────────────────────────────
def save_video_to_github(video_path, filename):
    """Save video to GitHub repo for download"""
    if not GITHUB_TOKEN or not REPO_NAME:
        log("GitHub not configured, video saved locally only")
        return False

    log("Uploading video to GitHub...")
    with open(video_path, "rb") as f:
        video_bytes = f.read()

    # GitHub has 100MB file limit — check size
    size_mb = len(video_bytes) / (1024*1024)
    if size_mb > 95:
        log(f"Video too large ({size_mb:.1f}MB) for GitHub, saving locally only")
        return False

    api_url = f"https://api.github.com/repos/{REPO_NAME}/contents/videos/{filename}"
    headers = {"Authorization": f"Bearer {GITHUB_TOKEN}", "Accept": "application/vnd.github+json"}

    sha = None
    ex = requests.get(api_url, headers=headers)
    if ex.ok:
        sha = ex.json().get("sha")

    data = {
        "message": f"Video: {TODAY}",
        "content": base64.b64encode(video_bytes).decode(),
        "branch": "main"
    }
    if sha:
        data["sha"] = sha

    r = requests.put(api_url, headers=headers, json=data)
    if r.ok:
        log(f"Video uploaded to GitHub: videos/{filename}")
        log(f"Download at: https://github.com/{REPO_NAME}/raw/main/videos/{filename}")
        return True
    else:
        log(f"GitHub upload failed: {r.status_code}")
        return False

# ── MAIN VIDEO PIPELINE ─────────────────────────────────────────────────────
def create_daily_video(issue):
    """Full pipeline: script -> voice -> footage -> compose -> upload"""
    print("\n" + "="*50)
    print("VIDEO GENERATOR - The Smart Dollar")
    print("="*50)

    work_dir = "/tmp/smart_dollar_video"
    Path(work_dir).mkdir(exist_ok=True)

    # 1. Generate script
    script_data = generate_script(issue)
    full_script  = script_data["full_script"]
    text_overlays = script_data["text_overlays"]
    search_terms  = script_data["video_search_terms"]

    log(f"Script ready: {len(full_script.split())} words")
    log(f"Hook: {script_data['hook'][:80]}...")

    # Save script for reference
    script_path = f"{work_dir}/script_{TODAY}.txt"
    with open(script_path, "w") as f:
        f.write("SCRIPT:\n" + full_script + "\n\nHOOK:\n" + script_data["hook"])

    # 2. Generate voiceover
    audio_path = f"{work_dir}/voiceover_{TODAY}.mp3"
    voice_ok = generate_voiceover(full_script, audio_path)

    # 3. Download stock footage
    footage_dir = f"{work_dir}/footage"
    footage_paths = []
    if PEXELS_API_KEY:
        footage_paths = download_footage(search_terms, footage_dir, count=4)
    else:
        log("No Pexels key, using animated background")

    # 4. Create text frames
    frames_dir = f"{work_dir}/frames"
    text_frames = create_text_frames(text_overlays, issue["headline"], frames_dir)

    # 5. Compose video
    video_filename = f"smart_dollar_{TODAY}.mp4"
    video_path = f"{work_dir}/{video_filename}"
    video_ok = compose_video(footage_paths, text_frames, audio_path, video_path, duration=60)

    # 6. Upload to GitHub
    if video_ok:
        save_video_to_github(video_path, video_filename)

        # Also save as artifact
        import shutil
        shutil.copy(video_path, f"/tmp/{video_filename}")

    # Return metadata for daily pack
    return {
        "script": full_script,
        "hook": script_data["hook"],
        "overlays": text_overlays,
        "tiktok_hashtags": "#SwissFinance #Switzerland #Schweiz #CHF #PersonalFinance #MoneyTips #Investing #FinanceTips #SmartMoney #FinancialFreedom #TikTokFinance #LearnOnTikTok #MoneyHacks #Finanzen #Geldtipps",
        "video_file": video_filename,
        "video_ok": video_ok
    }

